<Window
    x:Class="PlatinumToolkit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <NavigationView x:Name="NavView"
                    PaneDisplayMode="Left"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    SelectionChanged="NavView_SelectionChanged"
                    Loaded="NavView_Loaded">

        <NavigationView.Header>
            <Grid>
                <TextBox x:Name="SearchBox"
                         PlaceholderText="Search settings..."
                         HorizontalAlignment="Left"
                         Width="320" />
            </Grid>
        </NavigationView.Header>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Home" Tag="Home">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE80F;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="App Fetch" Tag="AppFetch">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE896;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="Power plans" Tag="PowerPlans">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE945;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="User Adjustments" Tag="UserAdjustments">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE77B;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="GPU" Tag="Category:GPU">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE950;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="Specs" Tag="Specs">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE9D9;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="Disk Cleanup" Tag="DiskCleanup">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItemSeparator />

            <NavigationViewItem x:Name="GeneralConfigItem"
                                 Content="General Configuration" Tag="Category:General Configuration">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge x:Name="GeneralConfigBadge" />
                </NavigationViewItem.InfoBadge>
            </NavigationViewItem>

            <NavigationViewItem x:Name="InterfaceTweaksItem"
                                 Content="Interface Tweaks" Tag="Category:Interface Tweaks">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE771;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge x:Name="InterfaceTweaksBadge" />
                </NavigationViewItem.InfoBadge>
            </NavigationViewItem>

            <NavigationViewItem Content="Windows Settings" Tag="Category:Windows Settings">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE770;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem x:Name="AdvancedConfigItem"
                                 Content="Advanced Configuration" Tag="Category:Advanced Configuration">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE9E9;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge x:Name="AdvancedConfigBadge" />
                </NavigationViewItem.InfoBadge>
            </NavigationViewItem>

            <NavigationViewItem Content="Security" Tag="Category:Security">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xEA18;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="Troubleshooting" Tag="Troubleshooting">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE9CE;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Settings" Tag="Settings">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
